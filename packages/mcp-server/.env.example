# Environment variable names read by the MCP server (src/index.ts, src/tools.ts).
# Copy to .env, then uncomment and fill in what you use. Never commit real credentials.

# Cal.com API key. Required when a tool calls the Cal.com API.
# CAL_API_KEY=

# Transport: "stdio", or any other value for HTTP Stream. Default: httpStream
# MCP_TRANSPORT=

# HTTP Stream listen port. Default: 8080
# PORT=
