# Environment variable names read by the SDK examples (examples/utils/env-config.ts,
# examples/basic-usage.ts). Copy to .env, then uncomment and fill in only what you use.
# Never commit real credentials.

# Authentication: set one method. Detection order is API key, OAuth client, managed user.

# API key authentication.
# CALDOTCOM_API_KEY=

# OAuth client authentication (both required together).
# CALDOTCOM_CLIENT_ID=
# CALDOTCOM_SECRET_KEY=

# Managed user authentication. The refresh token is optional.
# CALDOTCOM_ACCESS_TOKEN=
# CALDOTCOM_REFRESH_TOKEN=

# Optional client settings. Leave commented to use the SDK defaults.
# Default: https://api.cal.com/v2
# CALDOTCOM_BASE_URL=
# Default: 2024-08-13
# CALDOTCOM_API_VERSION=
# Request timeout in milliseconds. Default: 30000
# CALDOTCOM_TIMEOUT=
# Default: 3
# CALDOTCOM_MAX_RETRIES=
